{% extends "base.html" %}
{% load static %}

{% block content %}

<p><strong>Author:</strong> {{ recipe.author.username }}</p>

    <h2>{{ recipe.name }}</h2>
    <ul>
        {% for ingredient in recipe.ingredients.all %}
            <li>{{ ingredient.quantity }} of {{ ingredient.ingredient.name }}</li>
        {% endfor %}
    </ul>
{% endblock %}


