{% extends "base.html" %}
{% load static %}

{% block content %}
    <link rel="stylesheet" type="text/css" href="{% static 'css/styles.css' %}">
    
    <h2>Recipes</h2>
    <ul>
        {% for recipe in recipes %}
            <li><a href="{{ recipe.link }}">{{ recipe.name }}</a></li>
        {% endfor %}
    </ul>
{% endblock %}
