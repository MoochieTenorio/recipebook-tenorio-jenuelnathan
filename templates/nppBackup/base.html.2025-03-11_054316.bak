<header>
  <h1>RecipeBook</h1>
  <nav>
    <a href="{% url 'recipe_list' %}">Home</a> |
    {% if user.is_authenticated %}
      <a href="{% url 'profile' %}">{{ user.profile.name }}</a> |
      <a href="{% url 'logout' %}">Logout</a>
    {% else %}
      <a href="{% url 'login' %}">Login</a>
    {% endif %}
  </nav>
</header>
